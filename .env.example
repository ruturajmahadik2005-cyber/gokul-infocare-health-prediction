# Copy this file to .env and add credentials locally. Never commit .env.
FLASK_SECRET_KEY=replace-with-a-random-local-value
FLASK_DEBUG=false
DATABASE_PATH=patients.db

# Gemini API free tier: create a key in Google AI Studio.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional alternative: OpenAI API (requires API billing/credits).
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-6-luna
